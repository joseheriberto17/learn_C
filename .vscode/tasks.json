{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file (test_tarjeta_universal)",
            "command": "/usr/bin/gcc",
            "args": [
                "${workspaceFolder}/test_tarjeta_universal/main.c",
                "${workspaceFolder}/test_tarjeta_universal/SSD1306.c",
                "${workspaceFolder}/test_tarjeta_universal/SSD1306_cmd.c",
                "-o",
                "${workspaceFolder}/test_tarjeta_universal/main",
                "-Wall",
                "-g", // <— símbolos de debug
                "-O0" // <— sin optimización (más fácil depurar)
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}